<div id="smart_input_tasks" class="write_post_content flex flex-col flex-1 min-h-0">
  {#if @group}
    <div id="smart_input_tasks_content" class="flex flex-col flex-1 min-h-0">
      <Form
        for={%{}}
        as={:post}
        submit="Bonfire.Divlab:create_tasks"
        change="Bonfire.UI.Common.SmartInput:validate"
        opts={autocomplete: "off", "phx-target": "#smart_input"}
        class="flex flex-col flex-1 min-h-0"
      >
        <Bonfire.UI.Common.InputControlsLive
          smart_input_opts={@smart_input_opts}
          thread_mode={@thread_mode}
          reply_to_id={uid(@reply_to_id)}
          context_id={@context_id}
          create_object_type={@create_object_type}
          to_boundaries={@to_boundaries}
          to_circles={@to_circles}
          exclude_circles={@exclude_circles}
          showing_within={@showing_within}
          uploads={false}
          uploaded_files={@uploaded_files}
        >
          <div class="flex flex-1 min-h-0 flex-col overflow-y-auto px-4 pt-3">
            {!-- where the lines go: held here, sent with them --}
            <input type="hidden" name="post[into]" value={@into}>
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-sm text-base-content/60">{l("Into")}</span>
              <Dropdown
                id="tasks_into_menu"
                position="bottom-start"
                menu={false}
                close_on_select
                trigger_class="inline-flex h-8 max-w-full items-center gap-1.5 rounded-full border border-base-content/25 px-3 text-sm text-base-content transition-colors hover:bg-base-content/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                panel_class="!w-72 flex flex-col gap-0.5 p-1.5"
                label={l("Into: %{list}. Change", list: into_label(@into, @lists))}
              >
                <:trigger>
                  <#Icon iconify="ph:list-checks" class="size-4 shrink-0" />
                  <span data-role="tasks_into_chip" class="truncate">{into_label(@into, @lists)}</span>
                  <#Icon iconify="ph:caret-down" class="size-3.5 shrink-0" />
                </:trigger>
                <p :if={@lists != []} class="px-2 pt-1 text-xs text-base-content/60">{l("Open lists")}</p>
                {#for list <- @lists}
                  <button
                    type="button"
                    id={"tasks_into_option_#{list.id}"}
                    phx-click="Bonfire.Divlab:pick_into"
                    phx-value-into={list.id}
                    phx-target={@myself}
                    aria-pressed={to_string(@into == list.id)}
                    class="btn btn-ghost btn-sm !flex h-auto min-h-10 w-full justify-between gap-3 py-1.5 text-left !font-normal"
                  >
                    <span class="line-clamp-2 min-w-0">{Bonfire.Divlab.Web.Preview.ListLive.list_name(list)}</span>
                    {#case Map.get(@progress, list.id, {0, 0})}
                      {#match {done, total}}
                        <span class="shrink-0 text-xs tabular-nums text-base-content/60">{l("%{done} of %{total}", done: done, total: total)}</span>
                    {/case}
                  </button>
                {/for}
                {!-- `.dropdown-panel` is `display: block` when open, so each option is a full-width row of its own (`!flex w-full`) --}
                <div class="my-1 border-t border-base-content/10" />
                <button
                  type="button"
                  id="tasks_into_option_new"
                  phx-click="Bonfire.Divlab:pick_into"
                  phx-value-into="new"
                  phx-target={@myself}
                  aria-pressed={to_string(@into == "new")}
                  class="btn btn-ghost btn-sm !flex w-full justify-start gap-2 !font-normal"
                >
                  <#Icon iconify="ph:plus" class="size-4" />
                  {l("New list")}
                </button>
              </Dropdown>
            </div>

            {#if @into == "new"}
              {!-- `post[post_content][name]`, which the composer's validate counts as content; its own ignore wrapper, since every keystroke re-renders the composer. Enter moves to the first item (the `Title` hook) instead of submitting --}
              <div id="task_list_title_wrapper" phx-update="ignore" class="mt-3">
                <label for="task_list_title" class="sr-only">{l("List name")}</label>
                <input
                  id="task_list_title"
                  name="post[post_content][name]"
                  type="text"
                  phx-hook="Bonfire.Divlab.Web.CreateTasksLive#Title"
                  placeholder={l("Name the new list")}
                  class="w-full border-0 bg-transparent p-0 !text-xl font-medium placeholder:font-normal placeholder:text-base-content/40 focus:outline-none focus:ring-0"
                >
              </div>
              {!-- an optional description (the list's `note`), also editable on the list's page (tasks-v2 §15) --}
              <div id="task_list_note_wrapper" phx-update="ignore" class="mt-1">
                <label for="task_list_note" class="sr-only">{l("Description")}</label>
                <textarea
                  id="task_list_note"
                  name="post[list_note]"
                  rows="2"
                  placeholder={l("Add a description (optional)")}
                  class="w-full resize-none border-0 bg-transparent p-0 text-base text-base-content/80 placeholder:text-base-content/40 focus:outline-none focus:ring-0"
                />
              </div>
            {/if}

            {!-- the lines: the server never re-renders them (the composer's validate would reset what's being typed), the `Lines` hook adds, removes and renumbers them --}
            <ul
              id="task_lines"
              phx-update="ignore"
              phx-hook="Bonfire.Divlab.Web.CreateTasksLive#Lines"
              class="mt-3 flex flex-col"
            >
              <li data-role="task_line_row" class="flex min-h-10 items-center gap-3">
                <span class="size-4 shrink-0 rounded-full border-[1.5px] border-base-content/40" aria-hidden="true" />
                <label for="task_line_0" class="sr-only">{l("Item")}</label>
                <input
                  id="task_line_0"
                  data-role="task_line"
                  name="choices[0][name]"
                  type="text"
                  autocomplete="off"
                  placeholder={l("What needs doing? Enter for the next")}
                  class="w-full border-0 bg-transparent p-0 text-base placeholder:text-base-content/40 focus:outline-none focus:ring-0"
                >
              </li>
            </ul>
            <p class="py-3 text-xs text-base-content/60">{l("Enter for the next item · paste a checklist to add many · owners go on the items after")}</p>
          </div>
        </Bonfire.UI.Common.InputControlsLive>
      </Form>
    </div>
  {#else}
    <p id="smart_input_task_unavailable" class="p-4 text-sm text-muted">
      {l("Tasks are added from the Tasks page of a group that has turned them on.")}
    </p>
    {!-- the type tray is in the form's toolbar, absent here: the way back to a note --}
    <button
      type="button"
      phx-click={Bonfire.UI.Common.SmartInput.LiveHandler.open_base_type(@smart_input_opts)}
      phx-target="#smart_input"
      class="mx-4 text-sm underline underline-offset-2 hover:text-base-content focus-visible:ring-2 focus-visible:ring-primary"
    >{l("Write a post instead")}</button>
  {/if}
</div>
