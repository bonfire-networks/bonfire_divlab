<div id="tasks_board" class="flex flex-col">
  <nav
    aria-label={l("Task views")}
    class="flex gap-1 overflow-x-auto border-b-hair border-divider px-4 sm:px-6"
  >
    {#for view <- views()}
      <LinkPatchLive
        to={"#{path(@category)}/tasks/#{view}"}
        class={
          "flex shrink-0 items-center gap-1.5 border-b-2 px-3 py-2.5 text-sm transition-colors",
          "border-primary text-base-content": view == @view,
          "border-transparent text-muted hover:text-base-content": view != @view
        }
        opts={[id: "tasks_tab_#{view}", "aria-current": if(view == @view, do: "page")]}
      >
        {view_label(view)}
        <span :if={view != :done} data-role="count" class="text-xs tabular-nums text-muted">{if view == :lists, do: length(@task_lists), else: length(@lists[view] || [])}</span>
      </LinkPatchLive>
    {/for}
  </nav>
  {#if @view == :lists}
    {#if @task_lists == []}
      <p id="tasks_empty" role="status" class="px-4 py-10 text-center text-muted">{empty_message(:lists)}</p>
    {#else}
      <ul id="task_lists" class="divide-hair divide-divider">
        {#for list <- @task_lists}
          <li>
            <a
              href={"/discussion/#{id(list)}"}
              id={"task_list_#{id(list)}"}
              data-role="list_row"
              class={
                "flex flex-col gap-0.5 px-4 py-3 transition-colors hover:bg-base-content/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary sm:px-6",
                "opacity-70": list.finished
              }
            >
              <span data-role="list_row_name" class="break-words font-medium">{Bonfire.Divlab.Web.Preview.ListLive.list_name(list)}</span>
              <span class="flex flex-wrap gap-x-1.5 text-sm text-muted [&>*+*]:before:mr-1.5 [&>*+*]:before:inline-block [&>*+*]:before:content-['·']">
                <span :if={list.finished}>{l("Closed")}</span>
                <span class="tabular-nums">{list_progress(@progress, list)}</span>
              </span>
            </a>
          </li>
        {/for}
      </ul>
    {/if}
  {#else}
    {#case @lists[@view] || []}
      {#match []}
        <p id="tasks_empty" role="status" class="px-4 py-10 text-center text-muted">{empty_message(@view)}</p>
      {#match tasks}
        <ul id="tasks_list" class="divide-hair divide-divider">
          {#for task <- tasks}
            <Bonfire.Divlab.Web.TaskRowLive
              task={task}
              view={@view}
              members={@members}
              may_delete={MapSet.member?(@deletable, id(task))}
              event_target={@myself}
              show_list
            />
          {/for}
        </ul>
    {/case}
  {/if}
</div>
