<section :if={@enabled?} id="group_tasks" class="flex flex-col">
  <header class="flex items-center justify-between gap-3 px-4 pt-5 pb-1 sm:px-6">
    <h1 class="text-lg">{l("Tasks")}</h1>
    <Bonfire.UI.Common.SmartInputButtonLive
      id="group_tasks_new"
      component={Bonfire.Divlab.Web.CreateTaskLive}
      prompt={l("New task")}
      icon="ph:plus"
      icon_class="size-4"
      class="btn btn-sm btn-ghost gap-1.5 border border-base-content/15 !font-normal"
      smart_input_opts={%{
        context_id: id(@category),
        create_object_type: :task,
        to_circles: Bonfire.Classify.Boundaries.post_circles_for_group(@category),
        to_boundaries: List.wrap(Bonfire.Classify.Boundaries.read_default_content_visibility(@category))
      }}
    />
  </header>
  <Bonfire.Divlab.Web.TasksBoardLive
    id="group_tasks_board"
    category={@category}
    view={Bonfire.Divlab.Web.TasksBoardLive.view_for(@tab_id)}
  />
</section>
<p :if={!@enabled?} id="group_tasks_off" class="p-4 text-sm text-muted">
  {l("Tasks aren't turned on for this group.")}
</p>
